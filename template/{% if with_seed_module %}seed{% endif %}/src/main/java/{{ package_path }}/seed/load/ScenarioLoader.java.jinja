package {{ base_package }}.seed.load;

import java.util.List;
import java.util.ServiceLoader;

import {{ base_package }}.seed.scenario.Scenario;

/**
 * Extension point: pushes a {@link Scenario} to the stand through the steps and services of the main project. It
 * orchestrates calls only; requests belong in {@code src/main/.../service}, never in this module.
 *
 * <p>List the implementation in {@code seed/src/main/resources/META-INF/services/<this interface>}.
 */
@FunctionalInterface
public interface ScenarioLoader {

  void load(Scenario scenario);

  /**
   * The one implementation registered on the context class loader.
   */
  static ScenarioLoader discover() {
    return discover(Thread.currentThread().getContextClassLoader());
  }

  static ScenarioLoader discover(ClassLoader loader) {
    return single(ServiceLoader.load(ScenarioLoader.class, loader).stream().map(ServiceLoader.Provider::get).toList());
  }

  /**
   * Returns the only element, and fails with the registration to fix when there is none or more than one.
   */
  static ScenarioLoader single(List<ScenarioLoader> registered) {
    if (registered.size() == 1) {
      return registered.get(0);
    }
    String file = "seed/src/main/resources/META-INF/services/" + ScenarioLoader.class.getName();
    if (registered.isEmpty()) {
      throw new IllegalStateException("No " + ScenarioLoader.class.getName() + " is registered. Implement it with the project's "
        + "steps and list it in " + file + ", see docs/agents/seed-module.md.");
    }
    throw new IllegalStateException("More than one " + ScenarioLoader.class.getName() + " is registered: "
      + registered.stream().map(provider -> provider.getClass().getName()).toList() + ". Keep one in " + file + ".");
  }
}
