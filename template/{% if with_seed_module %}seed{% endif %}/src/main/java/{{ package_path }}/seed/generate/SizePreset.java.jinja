package {{ base_package }}.seed.generate;

import java.util.Arrays;
import java.util.Locale;

/**
 * How many records a scenario holds.
 */
public enum SizePreset {
  SMALL(5),
  MEDIUM(100),
  LARGE(1_000);

  private final int users;

  SizePreset(int users) {
    this.users = users;
  }

  public int users() {
    return users;
  }

  public String label() {
    return name().toLowerCase(Locale.ROOT);
  }

  public static SizePreset parse(String label) {
    return Arrays.stream(values())
      .filter(preset -> preset.label().equalsIgnoreCase(label))
      .findFirst()
      .orElseThrow(() -> new IllegalArgumentException("Unknown preset '" + label + "', expected one of "
        + Arrays.stream(values()).map(SizePreset::label).toList()));
  }
}
